# Copy to .env and set a fresh key locally, or set these variables in PowerShell.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://token.sensenova.cn/v1
OPENAI_MODEL=glm-5.2
# Comma-separated fallback models. The current model is tried first.
OPENAI_MODELS=deepseek-v4-flash,sensenova-6.8-flash-lite
# auto: glm-5.2/deepseek-v4-flash 开启，flash-lite 关闭；也可填 enabled/disabled
OPENAI_THINKING=auto
# Optional persona. Set to novelist for the built-in long-form fantasy persona.
OPENAI_PERSONA=novelist
